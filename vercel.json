    { "source": "/api/openrouter/(.*)", "destination": "https://openrouter.ai/$1" },
    { "source": "/api/cerebras/(.*)", "destination": "https://api.cerebras.ai/$1" },
    { "source": "/api/sambanova/(.*)", "destination": "https://api.sambanova.ai/$1" },
